{
  "name": "@promptprobe/seo-auto",
  "version": "0.2.0",
  "license": "MIT",
  "description": "A framework-neutral, draft-first toolkit for SEO content automation and technical SEO checks.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "example": "tsx examples/basic.ts",
    "example:opportunities": "tsx examples/opportunities.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "seo",
    "content-automation",
    "technical-seo",
    "json-ld",
    "typescript"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.0.0"
  }
}
