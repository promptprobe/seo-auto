# Copy to .env.local. Use a text editor; never paste credentials into a terminal command.
# Site and language are independent of GSC country/device filters.
SITE_URL=https://example.com/
SITE_LOCALE=en
SITE_INDEXABLE=false

# Copy the exact Search Console property: sc-domain:example.com OR https://example.com/
GSC_PROPERTY=sc-domain:example.com
# Empty means worldwide / all devices. Optional country examples: usa, esp, jpn.
GSC_COUNTRY=
GSC_DEVICE=

# A service-account JSON file you download yourself. Never commit it.
# Forward slashes also work in absolute Windows paths, e.g. C:/Users/you/keys/gsc.json.
GOOGLE_APPLICATION_CREDENTIALS=.secrets/gsc-service-account.json

# Canonical HTTPS WordPress installation URL (may include a subdirectory).
WORDPRESS_URL=https://example.com/
WORDPRESS_USER=
WORDPRESS_APPLICATION_PASSWORD=
# Leave false until posts + pages cover ALL content and drafts on this property.
# Requires an account that can read other authors' and private content.
WORDPRESS_INVENTORY_COMPLETE=false
# Optional local query ownership / URL aliases. See docs/onboarding/wordpress.md.
WORDPRESS_OWNERSHIP_FILE=
